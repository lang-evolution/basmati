(defpoll readings "./readings.py")

(defwindow main_panel
  :monitor "${basmati_monitor}"
  :geometry (geometry
    :x "0%"
    :y "20%"
    ; :width "100%"
    :anchor "bottom left")
  :stacking "fg"
  :windowtype "dock"
  :exclusive true
  :class "bar"
  ; :reserve (struts :distance "30px" :side "left")
  (box
      :class "dirty"
      :style "padding-left:10px"
      :halign "start"
      {readings[]}
      ; (box :class "battery" "${bat-raw}% Battery [${bat-status-raw}]")
    ))

